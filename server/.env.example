# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/akshar_paaul
# Set a long, random secret before deployment. Do not commit real secrets.
JWT_SECRET=
JWT_EXPIRES_IN=8h
PORT=4000
# The browser origin for local development. Add your deployed frontend origin in production.
CLIENT_ORIGIN=http://localhost:5173
# Groq API key: create one in https://console.groq.com/keys
GROQ_API_KEY=
# Vision-capable model used for both handwriting extraction and rubric-assisted suggestions.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# First administrator created by npm run seed:admin (do not commit real passwords)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Portal Administrator